{
  "name": "@seneca/dynamo-store",
  "description": "DynamoDB store for Seneca",
  "version": "6.2.0",
  "keywords": [
    "seneca",
    "dynamo",
    "dynamodb",
    "store",
    "plugin"
  ],
  "author": {
    "name": "Richard Rodger",
    "email": "richard@voxgig.com",
    "url": "http://richardrodger.com/"
  },
  "license": "MIT",
  "main": "dynamo-store.js",
  "scripts": {
    "test-create-db": "SENECA_DYNAMO_ENDPOINT=${SENECA_DYNAMO_ENDPOINT:-http://localhost:18001} node ./test/support/db/create-test-tables.js",
    "test-delete-db": "SENECA_DYNAMO_ENDPOINT=${SENECA_DYNAMO_ENDPOINT:-http://localhost:18001} node ./test/support/db/delete-test-tables.js",
    "test-list-tables": "SENECA_DYNAMO_ENDPOINT=${SENECA_DYNAMO_ENDPOINT:-http://localhost:18001} node ./test/support/db/list-test-tables.js",
    "test": "SENECA_DYNAMO_ENDPOINT=${SENECA_DYNAMO_ENDPOINT:-http://localhost:18001} lab -v -t 50 -P '\\.test' test -r console -o stdout -r html -o test/coverage.html -I AggregateError,atob,btoa,AbortController,AbortSignal,EventTarget,Event,MessageChannel,MessagePort,MessageEvent,performance,awslambda",
    "test-some": "SENECA_DYNAMO_ENDPOINT=${SENECA_DYNAMO_ENDPOINT:-http://localhost:18001} lab -v -P '\\.test' test -r console -g ",
    "test-msgs": "lab -t 50 -P messages.test -r console -o stdout -r html -o test/coverage.html",
    "prettier": "prettier --write --no-semi --single-quote *.js test/*.js",
    "reset": "npm run clean && npm i && npm test",
    "clean": "rm -rf node_modules package-lock.json yarn.lock",
    "repo-tag": "REPO_VERSION=`node -e \"console.log(require('./package').version)\"` && echo TAG: v$REPO_VERSION && git commit -a -m v$REPO_VERSION && git push && git tag v$REPO_VERSION && git push --tags;",
    "repo-publish-quick": "npm run prettier && npm test && npm run repo-tag && npm publish --access public --registry=https://registry.npmjs.org",
    "repo-publish": "npm run clean && npm i --registry=http://registry.npmjs.org && npm run repo-publish-quick",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down -v",
    "pretest": "npm run test-create-db"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dynamo-store.js",
    "dynamo-store-docs.js",
    "lib"
  ],
  "contributors": [
    "https://github.com/lilsweetcaligula",
    "Aleksandar Milenkovic - https://github.com/BeAllAround"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@hapi/code": "^9.0.3",
    "@hapi/lab": "^26.0.1",
    "prettier": "3.3.1",
    "seneca": "^4.0.0-rc5",
    "seneca-entity": "^28.1.0",
    "seneca-plugin-validator": "0.6.1",
    "seneca-promisify": "^3.7.2",
    "seneca-store-test": "^6.0.0"
  },
  "peerDependencies": {
    "seneca": ">=3||>=4.0.0-rc2",
    "seneca-entity": ">=26",
    "seneca-promisify": ">=3",
    "@aws-sdk/client-dynamodb": ">=3",
    "@aws-sdk/util-dynamodb": ">=3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/senecajs/seneca-dynamo-store.git"
  }
}
