From acbcbcd8eabd13140b698907a42649d5394fa156 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 12:09:33 +0000
Subject: [PATCH] Run CI with a DynamoDB Local service container

Test on Node 24 and 22 on ubuntu-latest for pushes and pull requests
to master (the default branch) and main. DynamoDB Local runs as a
service container on host port 18001; the image has no health check
tool, so a step waits for the port before the tests run.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LaHppcejXbSsAH4BZXNsjV
---
 .github/workflows/build.yml | 25 ++++++++++++++++++++-----
 1 file changed, 20 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index f67cea6..9bf30ae 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -2,25 +2,40 @@ name: build
 
 on:
   push:
-    branches: [main]
+    branches: [master, main]
   pull_request:
-    branches: [main]
+    branches: [master, main]
 
 jobs:
   build:
-    timeout-minutes: 6
+    timeout-minutes: 10
     strategy:
       fail-fast: false
       matrix:
-        os: [ubuntu-latest, windows-latest, macos-latest]
         node-version: [24.x, 22.x]
-    runs-on: ${{ matrix.os }}
+    runs-on: ubuntu-latest
+    services:
+      dynamodb:
+        image: amazon/dynamodb-local:3.3.1
+        ports:
+          - 18001:8000
+    env:
+      SENECA_DYNAMO_ENDPOINT: http://localhost:18001
     steps:
       - uses: actions/checkout@v4
       - name: Use Node.js ${{ matrix.node-version }}
         uses: actions/setup-node@v4
         with:
           node-version: ${{ matrix.node-version }}
+      # dynamodb-local has no health check tool and service containers
+      # cannot override the image command, so wait for the port here.
+      - name: Wait for DynamoDB Local
+        run: |
+          for i in $(seq 1 60); do
+            (exec 3<>/dev/tcp/127.0.0.1/18001) 2>/dev/null && exit 0
+            sleep 1
+          done
+          echo "DynamoDB Local did not start" && exit 1
       - run: npm install
       - run: npm run build --if-present
       - run: npm test
-- 
